# LokoAI Environment Variables Template
# Copy this file to .env and fill in your keys.

# OpenRouter API Key (Required for AI Chat & Code Generation)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter Models Configuration (Defaults: Chat = minimax/minimax-m2.7:free, Code Gen = z-ai/glm-5.2:free)
OPENROUTER_MODEL=minimax/minimax-m2.7:free
OPENROUTER_GENERATE_MODEL=z-ai/glm-5.2:free

# Optional: E2B Sandbox API Key (Required for live code preview execution sandboxes)
# E2B_API_KEY=

# Optional: E2B Sandbox Timeout (in minutes)
# E2B_SANDBOX_TIMEOUT_MINUTES=10

# Optional: Public site URL for HTTP Referer headers
NEXT_PUBLIC_SITE_URL=http://localhost:302
